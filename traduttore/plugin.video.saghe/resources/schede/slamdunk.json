orno più caldo di Hanamichi","p":"","i":"https://image.tmdb.org/t/p/w500/2zI6NIekmC4lR9la9jgOqIr6uNt.jpg","d":"1996-02-03"},"96":{"t":"Scarpe da basket II","p":"","i":"https://image.tmdb.org/t/p/w500/6qy5IqCggDKUrAjI7orHM7VqggL.jpg","d":"1996-02-10"},"97":{"t":"Il ritorno di Uozumi","p":"","i":"https://image.tmdb.org/t/p/w500/mmJrw6fRatM9UZFcli48hQhwjU4.jpg","d":"1996-02-17"},"98":{"t":"Shohoku vs Shoyo/Ryonan","p":"","i":"https://image.tmdb.org/t/p/w500/4ev6blkUKsWdt2AQrBj9Fj0g1Wi.jpg","d":"1996-02-24"},"99":{"t":"L'avversario più forte","p":"","i":"https://image.tmdb.org/t/p/w500/uvqKyVW9BGfYCxeyug4bhesaEKg.jpg","d":"1996-03-02"},"100":{"t":"L'uomo dei miracoli","p":"","i":"https://image.tmdb.org/t/p/w500/gkYVh0OuqC7bADGgkWwH9eFRjx1.jpg","d":"1996-03-09"},"101":{"t":"Slam Dunk","p":"","i":"https://image.tmdb.org/t/p/w500/o4rnQI85QOP2LMRJAaNvEQRBKnV.jpg","d":"1996-03-23"}}}