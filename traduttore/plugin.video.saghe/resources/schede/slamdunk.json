,"i":"https://image.tmdb.org/t/p/w500/r8ncQnQ80ELTmeCJGdOahwZrh9Y.jpg","d":"1995-04-15"},"65":{"t":"Il duello tra Sendoh e Maki","p":"","i":"https://image.tmdb.org/t/p/w500/8RLnnG5zViVnpG0ZhbaYCKxpaF8.jpg","d":"1995-04-29"},"66":{"t":"La scommessa di Sendoh","p":"","i":"https://image.tmdb.org/t/p/w500/l9U0Izo4XH9ZjfqcsSdaJx8GImo.jpg","d":"1995-05-13"},"67":{"t":"L'ultima partita: Shohoku contro Ryonan!","p":"","i":"https://image.tmdb.org/t/p/w500/oGOS8G1IOT8USIZknH6cApidk27.jpg","d":"1995-05-20"},"68":{"t":"Testa Rossa il salvatore","p":"","i":"https://image.tmdb.org/t/p/w500/yN0BcdYy6iLYnI8O2c5pYZwcIhz.jpg","d":"1995-05-27"},"69":{"t":"Gorilla Crisis","p":"","i":"https://image.tmdb.org/t/p/w500/dQY0ZS6VgQatZJVDtl0MNDfWTrc.jpg","d":"1995-06-03"},"70":{"t":"Gorilladunk II","p":"","i":"https://image.tmdb.org/t/p/w500/v8dlXC3N3AxA9qjBMM6MFysjL8t.jpg","d":"1995-06-10"},"71":{"t":"L'urlo della riscossa","p":"","i":"https://image.tmdb.org/t/p/w500/xcY9EQdGhumFSt44B9owzQUQbj9.jpg","d":"1995-06-17"},"72":{"t":"La grande umiliazione","p":"","i":"https://image.tmdb.org/t/p/w500/kgiQRBvy9efe6urKSaxINjoCFzf.jpg","d":"1995-07-01"},"73":{"t":"Shohoku – Ryonan, secondo tempo","p":"","i":"https://image.tmdb.org/t/p/w500/iVkzQeP4Qi3JubapsZQSo31yrzO.jpg","d":"1995-07-08"},"74":{"t":"L'avversario più pericoloso","p":"","i":"https://image.tmdb.org/t/p/w500/z09lFJiVdd0lrQLPTeLWmfStgQ2.jpg","d":"1995-07-15"},"75":{"t":"Fine play","p":"","i":"https://image.tmdb.org/t/p/w500/iizYeWwrVhvLRDmgZ1PGP0PVrBu.jpg","d":"1995-07-22"},"76":{"t":"Presagio di vittoria","p":"","i":"https://image.tmdb.org/t/p/w500/ycYwtkAuZx1I9LCzFlXRES4lEOX.jpg","d":"1995-08-05"},"77":{"t":"Siete forti, ragazzi","p":"","i":"https://image.tmdb.org/t/p/w500/o6C35GkOmUXBqjyHgkoeIDZutjG.jpg","d":"1995-08-12"},"78":{"t":"Il rientro di Uozumi","p":"","i":"https://image.tmdb.org/t/p/w500/iP6EO3mRRHEZRAIBuRU6CLz5D7U.jpg","d":"1995-08-19"},"79":{"t":"La Marea Blu","p":"","i":"https://image.tmdb.org/t/p/w500/mLqZRYTxS7HfBxGh5xYm